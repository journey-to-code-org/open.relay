{
  "name": "@journey-to-code/relay",
  "version": "0.1.0",
  "description": "Let people report a bug or ask for a feature from inside your app, with no GitHub account. The server files it as an issue.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./tidy": {
      "types": "./dist/tidy.d.ts",
      "default": "./dist/tidy.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "modern-screenshot": "^4.7.0"
  },
  "peerDependenciesMeta": {
    "modern-screenshot": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "modern-screenshot": "^4.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
